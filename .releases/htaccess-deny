# Denies every request. This file sits in directories that must NEVER be a
# document root: the release root (as <project>/.htaccess, next to vendor/
# and the signposts into shared/) and every store under shared/ (data/,
# config/, .propbase/, ...). In the correct layout Apache never reads it. If
# it answers a request with 403, a symlink or a document root points at the
# wrong place — the 403 is the alarm, not the fault. Without it the same
# mistake serves credentials and personal data as plain files.
#
# Master copy: .releases/htaccess-deny (framework). switch.php writes it into
# every shared store that lacks one. Copied verbatim, never edited.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
