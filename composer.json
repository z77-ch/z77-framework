{
    "name": "z77-ch/z77-framework",
    "description": "Z77 – PHP MVC framework monorepo. Develops the z77 Composer packages (kernel, module-frontend, module-backend, module-dms, persistence-doctrine, …) in one place; the published ones are split into their own read-only consume repos on push.",
    "type": "project",
    "keywords": ["php", "framework", "mvc", "flat-file", "monorepo", "z77"],
    "license": "MIT",
    "homepage": "https://github.com/z77-ch/z77-framework",
    "authors": [
        {
            "name": "Peter Ruepp",
            "email": "peter.ruepp@z77.ch"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "z77/kernel": "^1.0",
        "z77/module-frontend": "^1.0",
        "z77/module-backend": "^1.0",
        "z77/module-dms": "^1.0",
        "z77/module-vat": "^1.0",
        "z77/persistence-doctrine": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "support": {
        "issues": "https://github.com/z77-ch/z77-framework/issues",
        "source": "https://github.com/z77-ch/z77-framework"
    }
}
