{
    "name": "z77/module-mandator",
    "description": "Z77 Mandator Module | the installation's own company (Mandant): letterhead identity, UID, VAT liability and the ledger-account settings the business modules post with (plan §5.1 / §6.1 settings, owner decisions E1 / E2 of 2026-09-23).",
    "type": "library",
    "keywords": ["php", "framework", "mandator", "company", "letterhead", "settings", "z77"],
    "homepage": "https://github.com/z77-ch/z77-framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Ruepp",
            "email": "peter.ruepp@z77.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Z77\\Module\\Mandator\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "require": {
        "php": ">=8.4",
        "z77/kernel": "^1.0",
        "z77/persistence-doctrine": "^1.0"
    },
    "suggest": {
        "z77/module-financial": "Checks the mandator's account settings against the chart of accounts; without it the numbers are stored unverified."
    },
    "support": {
        "issues": "https://github.com/z77-ch/z77-framework/issues",
        "source": "https://github.com/z77-ch/module-mandator",
        "docs": "https://github.com/z77-ch/z77-framework/tree/main/docs"
    },
    "readme": "README.md"
}
