{
    "name": "z77/persistence-doctrine",
    "description": "Z77 Doctrine driver | relational persistence behind the kernel's UnifiedEntityManager — Doctrine ORM on MariaDB, reached through the same Repository API as the File driver.",
    "type": "library",
    "keywords": ["php", "framework", "doctrine", "orm", "mariadb", "z77"],
    "homepage": "https://github.com/z77-ch/z77-framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Ruepp",
            "email": "peter.ruepp@z77.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Z77\\Persistence\\Doctrine\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-pdo_mysql": "*",
        "z77/kernel": "^1.0",
        "doctrine/orm": "^3.7",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "symfony/cache": "^8.1"
    },
    "support": {
        "issues": "https://github.com/z77-ch/z77-framework/issues",
        "source": "https://github.com/z77-ch/persistence-doctrine",
        "docs": "https://github.com/z77-ch/z77-framework/tree/main/docs"
    },
    "readme": "README.md"
}
