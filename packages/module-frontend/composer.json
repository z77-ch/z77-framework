{
    "name": "z77/module-frontend",
    "description": "Z77 Frontend Module | the public-facing site: routing, pages, navigation and localized rendering.",
    "type": "library",
    "keywords": ["php", "framework", "mvc", "frontend", "z77"],
    "homepage": "https://github.com/z77-ch/z77-framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Ruepp",
            "email": "peter.ruepp@z77.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Z77\\Module\\Frontend\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "require": {
        "php": ">=8.2",
        "z77/kernel": "^1.0"
    },
    "suggest": {
        "z77/kibot": "KI-Bot widget with topic routing; enabled by config/client/kibot.inc.php (docs/topics/kibot.md)"
    },
    "support": {
        "issues": "https://github.com/z77-ch/z77-framework/issues",
        "source": "https://github.com/z77-ch/module-frontend",
        "docs": "https://github.com/z77-ch/z77-framework/tree/main/docs"
    },
    "readme": "README.md"
}
